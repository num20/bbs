# 掲示板名
BBS_TITLE=なんでも掲示板＠あの頃

# Litestream のレプリケーション先（S3 または S3 互換ストレージ）
LITESTREAM_BUCKET=your-bucket
LITESTREAM_REGION=us-east-1

# S3 互換ストレージを使う場合のみ指定（AWS S3 では空のまま）
#   例: Cloudflare R2 → https://<account-id>.r2.cloudflarestorage.com（REGION は auto）
#   例: MinIO        → http://minio.example.com:9000（FORCE_PATH_STYLE は true）
LITESTREAM_ENDPOINT=
LITESTREAM_FORCE_PATH_STYLE=false
