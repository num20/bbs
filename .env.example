# cp .env.example .env して値を変更してください
# ローカル起動（npm run dev / npm start）と docker compose の両方で読み込まれます

# 掲示板名
BBS_TITLE=なんでも掲示板＠あの頃

# トリップと ID の生成に使うソルト（公開する場合は必ず変更）
BBS_SALT=change-me-bbs-salt

# サーバーのポート（Docker ではホスト側のポート）
PORT=3000

# SQLite データベースファイルのパス（ローカル起動時のみ有効）
#   未指定時: server/bbs.db
#   相対パスは server/ ディレクトリからの相対になります
#   Docker ではコンテナ内の /data/bbs.db 固定で、名前付きボリューム bbs-data に保存されます
# DB_PATH=/path/to/bbs.db
